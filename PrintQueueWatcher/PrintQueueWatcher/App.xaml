<Application x:Class="PrintQueueWatcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ShutdownMode="OnExplicitShutdown": Ana pencere kapatıldığında (X'e
        basılınca) uygulama SONLANMAZ, çünkü bu uygulama aslında tepside
        çalışmaya devam etmelidir. Gerçek kapanış yalnızca tepsi menüsündeki
        "Çıkış" seçeneğiyle (App.Shutdown() çağrısıyla) gerçekleşir.
        Bkz. MainWindow.xaml.cs -> OnClosing override.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Varsayılan olarak Türkçe ve Açık tema yüklenir;
                     App.xaml.cs içinde kullanıcı ayarına göre değiştirilir. -->
                <ResourceDictionary Source="Localization/Strings.tr.xaml"/>
                <ResourceDictionary Source="Resources/Theme.Light.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Tepsi simgesi (NotifyIcon) burada tek bir kaynak olarak tanımlanır
                ve MainWindow.xaml.cs içinden Application.Current.Resources["TrayIcon"]
                ile erişilir. Menü olayları code-behind'da bağlanır.
            -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                             IconSource="pack://application:,,,/Resources/app.ico"
                             ToolTipText="PrintQueueWatcher"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
