<Window x:Class="PrintQueueWatcher.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk Seç"
        Height="320" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush_WindowBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hazır renk paleti -->
        <UniformGrid x:Name="PaletteGrid" Grid.Row="0" Columns="8" Rows="2" Margin="0,0,0,16"/>

        <!-- Önizleme -->
        <Border x:Name="PreviewBorder" Grid.Row="1" Height="50" CornerRadius="4"
                BorderBrush="{DynamicResource Brush_BorderColor}" BorderThickness="1"
                Margin="0,0,0,12"/>

        <!-- Hex giriş -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Hex:" Style="{StaticResource LabelText}" Width="40" VerticalAlignment="Center"/>
            <TextBox x:Name="HexTextBox" Width="140" Padding="6" TextChanged="HexTextBox_TextChanged"/>
        </StackPanel>

        <Grid Grid.Row="3"/>

        <!-- Tamam / İptal -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Str_CancelButton}" Style="{StaticResource SecondaryButton}"
                    Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="{DynamicResource Str_SaveButton}" Style="{StaticResource PrimaryButton}"
                    Width="90" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
