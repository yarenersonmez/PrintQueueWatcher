<Window x:Class="PrintQueueWatcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_SettingsTitle}"
        Height="720" Width="520"
        MinHeight="560" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush_WindowBackground}"
        Icon="pack://application:,,,/Resources/app.ico">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="28,24,28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===================== YAZICI ===================== -->
                <TextBlock Text="{DynamicResource Str_PrinterSection}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Str_PrinterSelectLabel}" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PrinterComboBox" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshPrintersButton" Grid.Column="1"
                            Content="{DynamicResource Str_RefreshPrinters}"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshPrintersButton_Click"/>
                </Grid>

                <!-- ===================== ZAMANLAMA ===================== -->
                <TextBlock Text="{DynamicResource Str_TimingSection}" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="WaitSecondsLabel" Style="{StaticResource LabelText}"/>
                <Slider x:Name="WaitSecondsSlider"
                        Minimum="10" Maximum="120"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="WaitSecondsSlider_ValueChanged"/>
                <TextBlock Text="{DynamicResource Str_WaitSecondsHint}" Style="{StaticResource HintText}"/>

                <TextBlock x:Name="CheckIntervalLabel" Style="{StaticResource LabelText}" Margin="0,16,0,0"/>
                <Slider x:Name="CheckIntervalSlider"
                        Minimum="1" Maximum="10"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="CheckIntervalSlider_ValueChanged"/>
                <TextBlock Text="{DynamicResource Str_CheckIntervalHint}" Style="{StaticResource HintText}"/>

                <!-- ===================== BİLDİRİM SESİ ===================== -->
                <TextBlock Text="{DynamicResource Str_NotificationSection}" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SoundComboBox" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button x:Name="TestSoundButton" Grid.Column="1"
                            Content="{DynamicResource Str_TestSound}"
                            Style="{StaticResource SecondaryButton}"
                            Click="TestSoundButton_Click"/>
                </Grid>

                <!-- ===================== UYARI PENCERESİ ===================== -->
                <TextBlock Text="{DynamicResource Str_AlertWindowSection}" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="{DynamicResource Str_AlertSizeLabel}" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="AlertSizeComboBox" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource Str_AlertBackgroundColor}" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <Border x:Name="BackgroundColorSwatch"
                                Height="36" CornerRadius="4"
                                BorderBrush="{DynamicResource Brush_BorderColor}" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonUp="BackgroundColorSwatch_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Str_AlertButtonColor}" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <Border x:Name="ButtonColorSwatch"
                                Height="36" CornerRadius="4"
                                BorderBrush="{DynamicResource Brush_BorderColor}" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonUp="ButtonColorSwatch_Click"/>
                    </StackPanel>
                </Grid>

                <Button Content="{DynamicResource Str_PreviewAlert}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Click="PreviewAlertButton_Click"/>

                <!-- ===================== GÖRÜNÜM ===================== -->
                <TextBlock Text="{DynamicResource Str_AppearanceSection}" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="{DynamicResource Str_ThemeLabel}" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="ThemeComboBox" Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource Str_LanguageLabel}" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="LanguageComboBox" Margin="0,0,0,12"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== KAYDET / İPTAL ===================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush_PanelBackground}"
                BorderBrush="{DynamicResource Brush_BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str_CancelButton}"
                        Style="{StaticResource SecondaryButton}"
                        Width="100" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button Content="{DynamicResource Str_SaveButton}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
