<Window x:Class="PrintQueueWatcher.Views.LanguageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Language / Dil Seçin"
        Height="320" Width="440"
        MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#FF1E1E1E"
        Icon="pack://application:,,,/Resources/app.ico">

    <!--
        Bu pencere bilinçli olarak DynamicResource / tema sistemine bağlı değildir:
        henüz hiçbir dil veya tema ayarı yapılmadan, uygulamanın ilk saniyesinde
        gösterilir. Bu yüzden hem Türkçe hem İngilizce metinleri sabit olarak
        (iki dilde birden) içerir ve sabit bir koyu renk paleti kullanır.
    -->
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Please select your language / Lütfen dilinizi seçin"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="White"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Button x:Name="TurkishButton"
                    Content="Türkçe"
                    FontSize="16" FontWeight="Bold"
                    Height="52" Margin="0,0,0,14"
                    Background="#FF0078D7" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="TurkishButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="EnglishButton"
                    Content="English"
                    FontSize="16" FontWeight="Bold"
                    Height="52"
                    Background="#FF3A3A3A" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="EnglishButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="You can change this later from Settings. / Bunu daha sonra Ayarlar'dan değiştirebilirsiniz."
                   FontSize="10.5"
                   Foreground="#FFAAAAAA"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,20,0,0"/>
    </Grid>
</Window>
